# Template do vault.yml (cifrado, fora do git). Senha própria do lab,
# diferente da do vault da produção: vazar uma não abre a outra.
#   ansible-vault create vault.yml
vault_tailscale_authkey: "tskey-auth-..."

# Backup do coolify-hetzner para a BorgBase (README do experimento). A
# passphrase também vai no Vaultwarden: sem ela, o repo é ilegível.
vault_borg_repo: "ssh://xxxxxxxx@xxxxxxxx.repo.borgbase.com/./repo"
vault_borg_passphrase: "..."

# PAT clássico do GitHub, só `read:packages`: o pull da imagem privada do
# coolify-teste-app no GHCR (README do experimento, seção CI/CD).
vault_ghcr_pat: "ghp_..."

# Piloto do AndBible. Gere dois hashes independentes com openssl passwd -6.
vault_andbible_dav_hashes:
  teste-1: '<hash-SHA512-crypt-da-primeira-senha>'
  teste-2: '<hash-SHA512-crypt-da-segunda-senha>'
