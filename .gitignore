# Estado e segredos: nunca entram no git. O state guarda o token do Proxmox,
# IPs e o que mais o provider devolver; cada experimento tem o seu.
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
crash.log
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars

# O .terraform.lock.hcl entra de propósito: fixa a versão dos providers.

# Ansible. O vault.yml é cifrado e mesmo assim fica fora do git, como no
# repo ansible: o template versionado é o vault.yml.example.
*.retry
.vault-pass
vault.yml
