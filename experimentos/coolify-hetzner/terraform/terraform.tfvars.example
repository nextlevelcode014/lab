# Projeto "lab" → Security → API tokens, leitura e escrita. Guardado no
# Vaultwarden como "Hetzner API token — lab". Nunca o token da produção.
hcloud_token   = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ssh_public_key = "ssh-ed25519 AAAA... lab"

# A auth key do Tailscale NÃO vai aqui: export TF_VAR_tailscale_authkey (README).

# O repo é público: o nome da tailnet fica só aqui, fora do git.
tailnet = "<tailnet>.ts.net"
