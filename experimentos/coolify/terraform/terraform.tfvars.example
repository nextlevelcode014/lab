# A string inteira, como está no Vaultwarden (já começa com lab@pve!terraform=).
# Colar só no lugar do UUID repete o prefixo e o Proxmox responde 401.
proxmox_api_token = "lab@pve!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
node_name         = "proxmox"
ssh_public_key    = "ssh-ed25519 AAAA... lab"
